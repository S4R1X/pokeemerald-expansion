mapscripts NewLab_MapScripts {}

script NewLab_EventScript_PokeballOne {

    lockall
        if(!(flag(FLAG_SELECTED_JANGMO_O) || flag(FLAG_SELECTED_FLABEBE) || flag(FLAG_SELECTED_ARON))){
    showmonpic(SPECIES_JANGMO_O, 5,3)
    msgbox("Do you want to choose Jangmo-o?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_JANGMO_O, 5)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved Jangmo-o")
            removeobject(1)
            setflag(FLAG_SELECTED_JANGMO_O)
            call(NicknamePartyMon)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved Jangmo-o")
            removeobject(1)
            setflag(FLAG_SELECTED_JANGMO_O)
            call(NicknameBoxMon)
        }
        else{
            hidemonpic
            msgbox("No More Room")
        }
    }
    else{
        hidemonpic
        msgbox(NewLab_NotChosen)
        }
    }
    else{
        msgbox("These pokemon are for another trainer.")
    }
    waitmessage
    releaseall
    end
 
}
