mapscripts Bodega_MapScripts {}

script You_Dont_Work_Here {
    lock
    applymovement(1, Cashiers_Only)
    msgbox("Hey kid, you know this is employees only!")
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, Access_Denied)
    applymovement(1, Return_To_Register)
    waitmovement
    release
}

script Sell_Rat {
    lock
    faceplayer
    if(flag(FLAG_RECIEVED_WIERD_RAT)){
        msgbox("I'll let you know if I find
        any think else in my dumpster.")
        waitmessage
        applymovement(2, Return_To_Register)
        waitmovement
        release
        return
    }
    msgbox("Check out this weird rat I
    found in the dumpster outback.
    I'll sell it to you for 1500p.", MSGBOX_YESNO)
    waitmessage
    if(var(VAR_RESULT) == YES){
        checkmoney(1500)
        if(var(VAR_RESULT) == TRUE){
            givemon(SPECIES_RATTATA_ALOLA, 3)
            if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
                msgbox("eheh, thanks for the cash! Enjoy the rat.")
                waitmessage
                playfanfare(MUS_OBTAIN_ITEM)
                msgbox("Recieved Rattata")
                setflag(FLAG_RECIEVED_WIERD_RAT)
                call(NicknamePartyMon)
            }
            elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
                msgbox("eheh, thanks for the cash! Enjoy the rat.")
                waitmessage
                playfanfare(MUS_OBTAIN_ITEM)
                msgbox("Recieved Rattata")
                setflag(FLAG_RECIEVED_WIERD_RAT)
                call(NicknameBoxMon)
            }
            else{
                hidemonpic
                msgbox("No More Room")
                waitmessage
            }
            waitmessage
        }
        else{
            msgbox("I am not running a charity!")
            waitmessage
        }
    }
    else{
        msgbox("Ugh, fine.")
        waitmessage
    }
    applymovement(2, Return_To_Register)
    waitmovement
    release
}


script Buy_Goods {
    //
}

movement Cashiers_Only {
    face_down
}

movement Access_Denied {
    walk_right
}

movement Return_To_Register {
    face_right
}